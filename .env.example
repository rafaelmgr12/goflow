# Copie para .env e execute make run.
# config.Load() carrega .env automaticamente.

DATABASE_URL='postgres://goflow:goflow@localhost:5432/goflow?sslmode=disable'
WORKER_COUNT=3
WORKER_JOB_TIMEOUT=30s
SCHEDULER_BATCH_SIZE=100
SCHEDULER_POLL_INTERVAL=5s

# log funciona sem credenciais. Para envio real, altere para resend.
EMAIL_PROVIDER=log
RESEND_API_KEY=''
# Para resend, preencha com um remetente autorizado na sua conta.
EMAIL_FROM=''

# Report
REPORT_PROVIDER=localfile
REPORT_OUTPUT_DIR=./output
